{
  "about": "AI eval fixture (design.md §5.4, #17). step = the procedure step the user is on (null: not started). tools must be called, forbid must not; args are checked as the transcript shows them; keywords must appear in the answer ('a|b' = either).",
  "cases": [
    { "id": "find-relief-valve", "utterance": "Where is the relief valve?", "step": null,
      "tools": ["highlight_part"], "args": { "highlight_part": { "part_id": "relief_valve" } }, "keywords": ["relief"] },
    { "id": "find-breaker", "utterance": "Show me the main breaker.", "step": null,
      "tools": ["highlight_part"], "args": { "highlight_part": { "part_id": "main_breaker" } }, "keywords": ["breaker"] },
    { "id": "find-gauge", "utterance": "Which one is the pressure gauge?", "step": null,
      "tools": ["highlight_part"], "args": { "highlight_part": { "part_id": "pressure_gauge" } }, "keywords": ["gauge"] },
    { "id": "find-inlet", "utterance": "I can't find the inlet valve.", "step": "close_inlet",
      "tools": ["highlight_part"], "args": { "highlight_part": { "part_id": "inlet_valve" } }, "keywords": ["inlet"] },
    { "id": "find-cartridge", "utterance": "Where's the new cartridge?", "step": "replace",
      "tools": ["highlight_part"], "args": { "highlight_part": { "part_id": "relief_cartridge" } }, "keywords": ["cartridge"] },
    { "id": "why-pressure-high", "utterance": "Why is the pressure so high?", "step": null,
      "tools": ["read_telemetry"], "forbid": ["start_procedure"], "keywords": ["relief|cartridge"] },
    { "id": "current-temperature", "utterance": "What's the motor temperature right now?", "step": null,
      "tools": ["read_telemetry"], "keywords": ["°C|degrees"] },
    { "id": "start-yes", "utterance": "Yes, let's start the procedure.", "step": null,
      "tools": ["start_procedure"], "args": { "start_procedure": { "procedure_id": "relief_valve_replacement" } }, "keywords": ["relief valve|step 1|inspect"] },
    { "id": "start-go-ahead", "utterance": "Go ahead and start it.", "step": null,
      "tools": ["start_procedure"], "keywords": ["inspect|step 1"] },
    { "id": "no-restart-while-running", "utterance": "What should I do now?", "step": "lockout",
      "forbid": ["start_procedure"], "keywords": ["breaker"] },
    { "id": "repeat-step", "utterance": "Can you show me step three again?", "step": "verify_zero",
      "tools": ["go_to_step"], "args": { "go_to_step": { "index": "3" } }, "forbid": ["start_procedure"], "keywords": ["inlet"] },
    { "id": "no-false-progress", "utterance": "I'm done with this step, move me to the next one.", "step": "lockout",
      "forbid": ["start_procedure"], "keywords": ["breaker|lock"] },
    { "id": "read-zero-done", "utterance": "The gauge reads zero now.", "step": "verify_zero",
      "tools": ["report_reading"], "keywords": ["cover|pressure"] },
    { "id": "loto-why", "utterance": "Why do I have to lock out the breaker first?", "step": "lockout",
      "keywords": ["motor|energ|start"] },
    { "id": "manual-loto", "utterance": "Open the lockout section of the manual for me.", "step": "lockout",
      "tools": ["show_manual"], "args": { "show_manual": { "section_id": "safety.loto" } }, "keywords": ["lock"] },
    { "id": "manual-relief", "utterance": "I want to read about the relief valve in the manual.", "step": null,
      "tools": ["show_manual"], "keywords": ["relief"] },
    { "id": "log-note", "utterance": "Note that the cover gasket looked worn.", "step": "remove_cover",
      "tools": ["log_note"], "keywords": ["note|log|gasket"] },
    { "id": "german", "utterance": "Can you speak German please?", "step": null,
      "tools": ["set_language"], "args": { "set_language": { "language": "de" } } },
    { "id": "labels-show", "utterance": "What is what on this machine? Show me all the labels.", "step": null,
      "tools": ["show_labels"], "args": { "show_labels": { "visible": "true" } } },
    { "id": "labels-hide", "utterance": "Hide the part labels again.", "step": null,
      "tools": ["show_labels"], "args": { "show_labels": { "visible": "false" } } },
    { "id": "cover-before-lockout", "utterance": "Can I take the pump cover off now?", "step": "lockout",
      "forbid": ["start_procedure"], "keywords": ["breaker|lock"] },
    { "id": "isolate-why", "utterance": "Why close the inlet before opening the pump?", "step": "close_inlet",
      "keywords": ["pressure"] },
    { "id": "restore-order", "utterance": "How do I put everything back?", "step": "refit_cover",
      "keywords": ["cover"] },
    { "id": "off-topic", "utterance": "What's the weather like in Berlin tomorrow?", "step": null,
      "forbid": ["highlight_part", "start_procedure", "read_telemetry"], "keywords": ["machine|pump|procedure|maintenance"] },
    { "id": "verify-running", "utterance": "Is the pressure back to normal?", "step": "verify_running",
      "tools": ["read_telemetry|report_reading"], "keywords": ["bar"] }
  ]
}
